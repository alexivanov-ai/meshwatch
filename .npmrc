; Skip dependency lifecycle scripts on install.
; Needed because npm currently ignores better-sqlite3's "gypfile": false and
; still runs "node-gyp rebuild" on a clean npm ci (npm/cli#9837). That fails on
; Windows runners without a recognised Visual Studio, even though v13 ships
; N-API prebuilds. Electron's binary is downloaded by scripts/ensure-electron.js
; (called from start/build scripts and from CI after npm ci).
ignore-scripts=true
