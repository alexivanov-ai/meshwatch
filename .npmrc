; Build native modules (better-sqlite3, ssh2's optional cpu-features) against
; Electron's own ABI during a plain `npm install`, instead of the system Node
; ABI. Electron ships prebuilt binaries for this combination, so this avoids
; needing Visual Studio Build Tools on a machine that only has Node.js
; installed. Keep the target in sync with the "electron" devDependency
; version in package.json.
runtime=electron
target=32.3.3
disturl=https://electronjs.org/headers
build_from_source=false
